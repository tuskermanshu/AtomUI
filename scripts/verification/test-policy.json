  "ignore": [
    "docs/**",
    "AGENTS.md",
    ".agents/**",
    ".github/copilot-instructions.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/PULL_REQUEST_TEMPLATE*",
    "README*",
    "CHANGELOG*",
    "LICENSE*",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    "resources/**"
  ],
  "tooling": [
    "scripts/run-full-regression.sh",
    "scripts/verification/affected/**",
    "scripts/verification/tests/**",
    "scripts/verification/test.py",
    "scripts/verification/test-policy.json",
    ".github/workflows/verify-affected.yml"
  ],
  "obligations": [
    {
      "id": "native-aot",
      "changes": [
        "src/AtomUI.Generator/**",
        "src/AtomUI.Generator.LinkedPublish/**",
        "src/AtomUI.Build.Tasks/LinkedRegistration/**",
        "src/AtomUI.Core/Registration/**",
        "src/AtomUI.Native/**",
        "build/**",
        "Directory.*",
        "global.json",
        "controlgallery/AtomUIGallery.Desktop/*.csproj",
        "controlgallery/AtomUIGallery.Desktop/scripts/**",
        "tests/AtomUI.LinkedRegistration*/**",
        "scripts/verification/verify-aot-*.sh",
        "src/AtomUI.Core/Theme/*Registration*",
        "src/AtomUI.Core/Theme/*Builder*",
        "src/**/*.csproj",
        "src/AtomUI.Build.Tasks/SourceGeneration/**",
        "src/AtomUI.Build.Tasks/LocalizationBuild/**",
        "src/AtomUI.Controls/Theme*",
        "src/AtomUI.Desktop.Controls*/Theme*"
      ],
      "description": "Validate the affected real NativeAOT/trim publish and startup paths according to docs/engineering/development/aot-programming-guidelines.md. Unit test success alone does not satisfy this obligation."
    },
    {
      "id": "package-layout",
      "changes": [
        "build/**",
        "scripts/BuildNuGetPackages.ps1",
        "scripts/NuGetPackageProjects.ps1",
        "scripts/verification/verify-package-layout*",
        "scripts/verification/package-layout-allowlist.json",
        "scripts/verification/verify-build-task-isolation.ps1",
        ".github/workflows/release-nuget-packages.yml",
        "src/**/*.csproj",
        "src/**/*.nuspec"
      ],
      "description": "Validate actual package assets with scripts/verification/verify-package-layout.ps1 and verify-build-task-isolation.ps1 for the affected package configuration."
    },
    {
      "id": "platform-interaction",
      "changes": [
        "src/AtomUI.Native/**",
        "controlgallery/AtomUIGallery.Browser/**",
        ".github/workflows/release-gallery.yml"
      ],
      "description": "Run the affected platform host and validate its original interaction/startup contract; record platform and concrete evidence."
    },
    {
      "id": "performance",
      "changes": [
        "tools/performances/**"
      ],
      "description": "Run the changed performance scenario with a comparable baseline; unit tests do not establish performance."
    },
    {
      "id": "dependency-compatibility",
      "changes": [
        "build/Versions.props",
        "Directory.Packages.props",
        "global.json"
      ],
      "description": "Shared dependency or SDK changes require explicit full test scope plus affected target-framework/platform validation; ordinary module tests cannot establish compatibility."
    }
  ]
}
