<Project>
    <Import Project="$(MSBuildThisFileDirectory)Versions.props" />
    <Import Project="$(MSBuildThisFileDirectory)ProjectDefaults.props" />
    <Import Project="$(MSBuildThisFileDirectory)PackageMetadata.props" />
    <Import Project="$(MSBuildThisFileDirectory)OutputPaths.props" />
    <!-- Imported only for validation runs. In ordinary Debug/Release development builds the
         property below is unset, so this file is not read at all and adds no evaluation cost to
         the inner development loop. -->
    <Import Project="$(MSBuildThisFileDirectory)PackageValidation.props"
            Condition="'$(AtomUIPackageValidationBaselineVersion)' != '' or '$(EnablePackageValidation)' == 'true'" />

    <PropertyGroup>
        <AtomUIRepositoryBuild>true</AtomUIRepositoryBuild>
        <AtomUIBuildTasksOutputDirectory Condition="'$(AtomUIBuildTasksOutputDirectory)' == ''">$(OutputPathWithoutFramework)/build-tasks</AtomUIBuildTasksOutputDirectory>
        <AtomUIBuildTasksAssembly Condition="'$(AtomUIBuildTasksAssembly)' == ''">$(AtomUIBuildTasksOutputDirectory)/net10.0/AtomUI.Build.Tasks.dll</AtomUIBuildTasksAssembly>
        <AtomUITypeMapBackendProject>$(MSBuildThisFileDirectory)../src/AtomUI.TypeMap.Linker/AtomUI.TypeMap.Linker.csproj</AtomUITypeMapBackendProject>
    </PropertyGroup>

    <ItemGroup>
        <AtomUINuGetBuildAsset Include="$(MSBuildThisFileDirectory)AtomUI.Generator.props;
                                         $(MSBuildThisFileDirectory)AtomUI.Generator.targets;
                                         $(MSBuildThisFileDirectory)AtomUI.Registration.targets;
                                         $(MSBuildThisFileDirectory)AtomUI.Localization.props;
                                         $(MSBuildThisFileDirectory)AtomUI.Localization.targets;
                                         $(MSBuildThisFileDirectory)AtomUI.ThemeAssets.targets;
                                         $(MSBuildThisFileDirectory)AtomUI.Build.Tasks.Process.cs">
            <PackagePath>buildTransitive/%(Filename)%(Extension)</PackagePath>
        </AtomUINuGetBuildAsset>

        <AtomUIGeneratorToolAsset Include="$(OutputPathWithoutFramework)/netstandard2.0/AtomUI.Generator.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Reflection.Metadata.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Collections.Immutable.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Memory.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Buffers.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Numerics.Vectors.dll;
                                           $(OutputPathWithoutFramework)/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll">
            <PackagePath>tools/netstandard2.0/%(Filename)%(Extension)</PackagePath>
        </AtomUIGeneratorToolAsset>
        <AtomUIGeneratorToolAsset Include="$(AtomUIBuildTasksOutputDirectory)/net10.0/AtomUI.Build.Tasks.dll;
                                           $(AtomUIBuildTasksOutputDirectory)/net10.0/AtomUI.Build.Tasks.deps.json;
                                           $(AtomUIBuildTasksOutputDirectory)/net10.0/AtomUI.Build.Tasks.runtimeconfig.json;
                                           $(AtomUIBuildTasksOutputDirectory)/net10.0/Microsoft.Build.Framework.dll">
            <PackagePath>tools/net10.0/%(Filename)%(Extension)</PackagePath>
        </AtomUIGeneratorToolAsset>
    </ItemGroup>

    <ItemGroup>
        <AtomUIGeneratorToolAsset Include="$(OutputPathWithoutFramework)/net10.0/AtomUI.TypeMap.Linker.dll;$(OutputPathWithoutFramework)/net10.0/AtomUI.TypeMap.Linker.deps.json">
            <PackagePath>tools/typemap/%(Filename)%(Extension)</PackagePath>
        </AtomUIGeneratorToolAsset>
        <AtomUIRegistrationToolCandidate Include="$(OutputPathWithoutFramework)/net10.0/AtomUI.TypeMap.Linker.dll" Kind="Backend" />
        <AtomUIRegistrationToolCandidate Include="$(AtomUIBuildTasksAssembly)" Kind="Tasks" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)AtomUI.Generator.props" />
</Project>
