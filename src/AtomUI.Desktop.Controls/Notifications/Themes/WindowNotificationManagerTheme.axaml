<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowNotificationManager}" TargetType="atom:WindowNotificationManager">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:FeedbackStackPresenter Name="PART_Items" />
            </ControlTemplate>
        </Setter>

        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Style Selector="^[Position=TopLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationTopMargin}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationTopMargin}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=TopRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationTopMargin}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^[Position=BottomLeft] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationBottomMargin}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomCenter] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationBottomMargin}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^[Position=BottomRight] /template/ atom|FeedbackStackPresenter#PART_Items">
            <Setter Property="Margin" Value="{atom:NotificationCardTokenResource NotificationBottomMargin}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
