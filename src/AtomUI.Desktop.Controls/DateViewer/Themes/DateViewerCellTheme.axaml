<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:converters="using:Avalonia.Controls.Converters"
              xmlns:viewer="clr-namespace:AtomUI.Desktop.Controls.Internal.DateViewer"
              x:Class="AtomUI.Desktop.Controls.Themes.DateViewerCellTheme"
              x:ClassModifier="internal" TargetType="viewer:DateViewerCell">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <ControlTheme.Resources>
        <converters:CornerRadiusFilterConverter x:Key="StartCorners" Filter="TopLeft, BottomLeft" />
        <converters:CornerRadiusFilterConverter x:Key="EndCorners" Filter="TopRight, BottomRight" />
    </ControlTheme.Resources>
    <Setter Property="MinHeight" Value="{atom:SharedTokenResource ControlHeight}" />
    <Setter Property="Template">
        <ControlTemplate TargetType="viewer:DateViewerCell">
            <Border Name="PART_CellRoot" Background="Transparent">
                <Grid Name="PART_Layout" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <Border Name="PART_RangeMiddle" Grid.ColumnSpan="2" IsVisible="False"
                                Background="{atom:DateViewerTokenResource CellRangeBg}" />
                        <Border Name="PART_RangeStart" Grid.Column="1" IsVisible="False"
                                Background="{atom:DateViewerTokenResource CellRangeBg}" />
                        <Border Name="PART_RangeEnd" Grid.Column="0" IsVisible="False"
                                Background="{atom:DateViewerTokenResource CellRangeBg}" />
                        <Border Name="PART_WeekSelection" Grid.ColumnSpan="2" />
                    </Grid>
                    <Border Name="PART_ValueFrame" Grid.Row="0"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <atom:TextBlock Name="PART_Value" Text="{TemplateBinding DisplayText}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ContentControl Name="PART_CellContent" Classes.semantic-cell-content="True" Grid.Row="1"
                                    Content="{TemplateBinding Context}" ContentTemplate="{TemplateBinding CellTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    IsVisible="False" />
                </Grid>
            </Border>
        </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
    <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
    <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
    <Style Selector="^ /template/ Border#PART_ValueFrame">
        <Setter Property="MinWidth" Value="{atom:DateViewerTokenResource CellWidth}" />
        <Setter Property="MinHeight" Value="{atom:DateViewerTokenResource CellHeight}" />
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^[IsMotionEnabled=True] /template/ Border#PART_ValueFrame">
        <Setter Property="Transitions">
            <Transitions>
                <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="^ /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:week-mode /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[IsMotionEnabled=True]:week-mode /template/ Border#PART_WeekSelection">
        <Setter Property="Transitions">
            <Transitions>
                <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="^:today:date">
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
    </Style>
    <Style Selector="^:month /template/ Border#PART_ValueFrame, ^:quarter /template/ Border#PART_ValueFrame, ^:year /template/ Border#PART_ValueFrame">
        <Setter Property="Width" Value="{atom:DateViewerTokenResource PeriodCellWidth}" />
        <Setter Property="Padding" Value="{atom:DateViewerTokenResource PeriodCellPadding}" />
    </Style>
    <Style Selector="^:visual-endpoint:not(:disabled), ^:navigation-current:not(:disabled)">
        <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:range-middle:not(:week-mode):not(:has-preview):not(:outside) /template/ Border#PART_RangeMiddle, ^:range-preview-middle:not(:week-mode):not(:outside) /template/ Border#PART_RangeMiddle">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:range-start:not(:week-mode):not(:range-end):not(:has-preview):not(:outside) /template/ Border#PART_RangeStart, ^:range-preview-start:not(:week-mode):not(:range-preview-end):not(:outside) /template/ Border#PART_RangeStart">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:range-end:not(:week-mode):not(:range-start):not(:has-preview):not(:outside) /template/ Border#PART_RangeEnd, ^:range-preview-end:not(:week-mode):not(:range-preview-start):not(:outside) /template/ Border#PART_RangeEnd">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:week-mode /template/ Border#PART_RangeMiddle, ^:week-mode /template/ Border#PART_RangeStart, ^:week-mode /template/ Border#PART_RangeEnd">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:range-start:not(:range-end):not(:range-preview-end) /template/ Border#PART_ValueFrame, ^:range-preview-start:not(:range-end):not(:range-preview-end) /template/ Border#PART_ValueFrame">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=viewer:DateViewerCell}, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:range-end:not(:range-start):not(:range-preview-start) /template/ Border#PART_ValueFrame, ^:range-preview-end:not(:range-start):not(:range-preview-start) /template/ Border#PART_ValueFrame">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=viewer:DateViewerCell}, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^:week-selection-start, ^:week-selection-middle, ^:week-selection-end, ^:week-mode:hovered">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:week-selection-start /template/ Border#PART_WeekSelection, ^:week-selection-middle /template/ Border#PART_WeekSelection, ^:week-selection-end /template/ Border#PART_WeekSelection, ^:week-mode:hovered /template/ Border#PART_WeekSelection">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
    </Style>
    <Style Selector="^:week-mode:range-middle /template/ Border#PART_WeekSelection, ^:week-mode:range-preview-middle /template/ Border#PART_WeekSelection">
        <Setter Property="Background" Value="{atom:DateViewerTokenResource CellRangeBg}" />
    </Style>
    <Style Selector="^:week-selection-start /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:week-selection-end /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^:week-mode:week /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StartCorners}}" />
    </Style>
    <Style Selector="^:week-mode:last-week-day /template/ Border#PART_WeekSelection">
        <Setter Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EndCorners}}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_RangeMiddle, ^ /template/ Border#PART_RangeStart, ^ /template/ Border#PART_RangeEnd, ^ /template/ Border#PART_WeekSelection">
        <Setter Property="Height" Value="{atom:DateViewerTokenResource CellHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:pointerover:not(:week-mode):not(:selected):not(:disabled):not(:navigation-current):not(:range-start):not(:range-middle):not(:range-end):not(:range-preview-start):not(:range-preview-middle):not(:range-preview-end):not(:week-selection-start):not(:week-selection-middle):not(:week-selection-end)">
        <Setter Property="Background" Value="{atom:DateViewerTokenResource CellHoverBg}" />
    </Style>
    <Style Selector="^:outside">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:week">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:week-selection-start, ^:week-selection-middle, ^:week-selection-end, ^:week-mode:hovered">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLightSolid}" />
    </Style>
    <Style Selector="^:week-mode:week /template/ atom|TextBlock#PART_Value">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:cell-template /template/ ContentControl#PART_CellContent">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:full-template /template/ ContentControl#PART_CellContent">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.RowSpan" Value="2" />
        <Setter Property="ContentTemplate" Value="{Binding EffectiveFullCellTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^:full-template /template/ Border#PART_ValueFrame">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Presentation=Content]">
        <Setter Property="MinHeight" Value="{atom:DateViewerTokenResource ContentCellMinHeight}" />
    </Style>
    <Style Selector="^[Presentation=Compact] /template/ Grid#PART_Layout">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ControlTheme>
