<atom:Splash
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUIGallery.ShowCases.Splash.GalleryWindowSplash"
    x:ClassModifier="internal"
    Classes="gallery-window-splash">
    <atom:Splash.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0B1026" Offset="0" />
            <GradientStop Color="#1D39C4" Offset="0.48" />
            <GradientStop Color="#13C2C2" Offset="1" />
        </LinearGradientBrush>
    </atom:Splash.Background>

    <!-- 专用启动页视觉通过生成的 Semantic Part Style 表达，不穿透 Splash 模板。
         外层 Style 负责 owner 类型与业务 class，生成的 Style 类型封装模板路由与 Setter 契约。 -->
    <atom:Splash.Styles>
        <Style Selector="atom|Splash.gallery-window-splash">
            <atom:SplashTitleStyle x:SetterTargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
            </atom:SplashTitleStyle>
            <atom:SplashSubtitleStyle x:SetterTargetType="TextBlock">
                <Setter Property="Foreground" Value="#D6E4FF" />
            </atom:SplashSubtitleStyle>
            <atom:SplashDetailStyle x:SetterTargetType="TextBlock">
                <Setter Property="Foreground" Value="#D6E4FF" />
            </atom:SplashDetailStyle>
        </Style>

        <!-- 普通消息覆盖只在 :loading 生效；Success / Error 继续使用标准主题的状态色。 -->
        <Style Selector="atom|Splash.gallery-window-splash:loading">
            <atom:SplashMessageStyle x:SetterTargetType="TextBlock">
                <Setter Property="Foreground" Value="#F5F8FF" />
            </atom:SplashMessageStyle>
        </Style>
    </atom:Splash.Styles>
</atom:Splash>
